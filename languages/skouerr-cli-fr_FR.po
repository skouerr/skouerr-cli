#. Plugin Name of the plugin
#: skouerr-cli.php
msgid "Skouerr CLI"
msgstr "Skouerr CLI"

#. Plugin URI of the plugin
#: skouerr-cli.php
msgid "https://skouerr.dev"
msgstr "https://skouerr.dev"

#. Description of the plugin
#: skouerr-cli.php
msgid "WP-CLI commands and abilities to scaffold and maintain Skouerr FSE themes. Agent-friendly: JSON output, non-interactive mode, dry-run, Abilities API."
msgstr "Commandes WP-CLI et abilities pour générer et maintenir les thèmes FSE Skouerr. Adapté aux agents : sortie JSON, mode non interactif, dry-run, Abilities API."

