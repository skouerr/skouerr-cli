<?xml version="1.0"?>
<ruleset name="Skouerr CLI">
    <description>WordPress Coding Standards for Skouerr CLI</description>

    <file>skouerr-cli.php</file>
    <file>src</file>
    <file>tests</file>

    <!-- Fake HTTP server used by the integration tests. -->
    <exclude-pattern>tests/integration/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <config name="minimum_supported_wp_version" value="6.5"/>
    <config name="testVersion" value="8.3-"/>

    <rule ref="WordPress-Extra">
        <exclude name="WordPress.PHP.YodaConditions.NotYoda"/>
        <!-- PSR-4 file names (src/Command/MakeBlockCommand.php). -->
        <exclude name="WordPress.Files.FileName"/>
        <!-- The plugin runs in WP-CLI only: output is plain text, not HTML. -->
        <exclude name="WordPress.Security.EscapeOutput"/>
    </rule>

    <rule ref="WordPress-Docs">
        <!-- Overridden methods use {@inheritDoc}. -->
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
        <exclude name="Squiz.Commenting.FunctionCommentThrowTag.Missing"/>
        <!-- Generic types (list<string>, array{...}) are checked by PHPStan. -->
        <exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
        <!-- Inline @var annotations. -->
        <exclude name="Generic.Commenting.DocComment.MissingShort"/>
    </rule>

    <!-- $default is the natural name for prompt defaults; named arguments are not used on these methods. -->
    <rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
        <severity>0</severity>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="skouerr-cli"/>
        </properties>
    </rule>

    <!-- Tests follow PHPUnit conventions. -->
    <rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Commenting">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Commenting.DocComment.MissingShort">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
